{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es2020",
      "dom"
    ],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "jest",
      "node"
    ],
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "src/core/**/*",
    "src/venmo/**/*",
    "src/ocr/extract.ts"
  ]
}
