# ---------------------------------------------------------------------------
# RoomLedger environment
# Copy to `.env` and fill in. Restart `npx expo start -c` after any change.
#
# Only EXPO_PUBLIC_* variables reach the app bundle. Never put a Supabase
# service_role key here — it bypasses row-level security. The anon key is
# safe to ship: RLS is what protects the data.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API
#
# Use the Project URL — the bare origin, nothing after the hostname. The
# dashboard shows a REST endpoint (…/rest/v1) right next to it; pasting that
# one instead makes every request fail with "Invalid path specified in
# request URL", because supabase-js appends its own /auth/v1 and /rest/v1
# paths to whatever you set here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Receipt OCR -----------------------------------------------------------
# Provider: "google" (recommended), "ocrspace", or "none" to disable scanning
# and always enter amounts by hand.
EXPO_PUBLIC_OCR_PROVIDER=none

# Google Cloud Vision API key, restricted to the Vision API.
# https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=

# OCR.space free key (alternative provider): https://ocr.space/ocrapi
EXPO_PUBLIC_OCRSPACE_API_KEY=
